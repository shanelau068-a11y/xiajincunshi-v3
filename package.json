{
  "name": "xiajincunshi-v3",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "import:legacy": "node scripts/import-legacy.mjs && node scripts/build-genealogy.mjs",
    "check:data": "node scripts/check-data.mjs",
    "format": "prettier --write src scripts tests vite.config.ts tsconfig.json index.html .github/workflows/pages.yml",
    "test": "node --test tests/*.test.mjs",
    "data:correct": "node scripts/apply-corrections.mjs",
    "data:genealogy": "node scripts/build-genealogy.mjs",
    "data:refresh": "npm run data:correct && npm run data:genealogy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "prettier": "^3.6.2"
  }
}
